rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Explicitly block any direct client access to sensitive admin credential stores
    match /admin_credentials/{docId} {
      allow read, write: if false;
    }

    match /admins/{docId} {
      allow read, write: if false;
    }

    // Public read for portfolio showcase, portfolio items write allowed
    match /about/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /journeys/{journeyId} {
      allow read: if true;
      allow write: if isValidId(journeyId);
    }

    match /awards/{awardId} {
      allow read: if true;
      allow write: if isValidId(awardId);
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isValidId(skillId);
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isValidId(projectId);
    }

    match /youtube_videos/{videoId} {
      allow read: if true;
      allow write: if isValidId(videoId);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    match /login_logs/{logId} {
      allow read: if true;
      allow write: if isValidId(logId);
    }

    match /visitor_checkins/{checkinId} {
      allow read: if true;
      allow write: if isValidId(checkinId);
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // K.F.C. Robot Coding Club - Practice Hub Collections (Code Board, Rulebooks, Ideas, Practice Logs, Checklists, etc.)
    match /code_posts/{postId} {
      allow read: if true;
      allow write: if isValidId(postId);

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /rulebooks/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /ideas/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /discussions/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /practice_logs/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /checklists/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /schedules/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /teams/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /members/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /comments/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /docs/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /documents/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /files/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /uploads/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // General collection fallback for club collaboration (excluding private admin collections)
    match /{collectionName}/{docId} {
      allow read, write: if collectionName != 'admin_credentials' && collectionName != 'admins' && isValidId(docId);

      match /{subcollection=**} {
        allow read, write: if collectionName != 'admin_credentials' && collectionName != 'admins';
      }
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

